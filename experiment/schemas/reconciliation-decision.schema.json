{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emac.example/schemas/reconciliation-decision.schema.json",
  "title": "EmaC reconciliation decision v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "reconciliationVersion",
    "baseModelVersion",
    "candidateDeltaVersion",
    "status",
    "reasons",
    "admittedFields",
    "rejectedFields",
    "bindingDecisions",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {"const": "emac.reconciliation-decision/v1"},
    "reconciliationVersion": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseModelVersion": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateDeltaVersion": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["identified", "unresolved", "contradictory"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "admittedFields": {"type": "array", "items": {"type": "string"}},
    "rejectedFields": {"type": "array", "items": {"type": "string"}},
    "bindingDecisions": {"type": "array"},
    "evidenceRefs": {"type": "array", "minItems": 1}
  }
}
